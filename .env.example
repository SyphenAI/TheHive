# Copy to .env. Both keys are REQUIRED; the app refuses to start with placeholders.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_FERNET_KEY=

APP_ENV=pre-prod
DEFAULT_ADMIN_USERNAME=hive
DEFAULT_ADMIN_PASSWORD=change-on-first-login

# Hard ceilings in USD. Per-session budgets are set in the UI and cannot exceed what's left here.
GLOBAL_DAILY_BUDGET_USD=10
GLOBAL_MONTHLY_BUDGET_USD=100

# Only enable Swagger locally while developing.
ENABLE_API_DOCS=false
CORS_ORIGINS=http://127.0.0.1:50090,http://localhost:50090

# Auth hardening
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOCKOUT_THRESHOLD=8
LOCKOUT_MINUTES=15
MAX_BODY_BYTES=2097152
# Set automatically by docker-compose.tls.yml; only set by hand if you front the app with your own TLS proxy.
# BEHIND_TLS=true

# Update awareness. The app only *tells* you a newer version exists (admin sidebar); it never self-updates.
# channel: release (compare VERSION to latest GitHub release) | pre-prod | main (compare build sha to branch head)
UPDATE_CHECK_ENABLED=true
UPDATE_CHANNEL=release
# Optional: raises GitHub API rate limit and lets the check see a private repo. Read-only PAT, Contents: read.
# GITHUB_TOKEN=

# Optional: restrict the "Add context → url" fetcher to these hosts (suffix match, comma-separated).
# Empty = any public host. Does not affect provider or scholar API calls.
# OUTBOUND_ALLOWED_HOSTS=github.com,owasp.org,nist.gov
